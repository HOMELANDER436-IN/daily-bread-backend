# Daily Bread — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Admin Credentials ────────────────────────────────────────
# The admin user is auto-created in Firestore on first server start
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_secure_password

# ─── Firebase (Service Account) ───────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate new private key → Download JSON
# Then extract the three values below:
FIREBASE_PROJECT_ID=manual-4b66a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@manual-4b66a.iam.gserviceaccount.com
# Paste the private_key value from the JSON — keep the quotes and \n characters as-is
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For development, leave as * or list your Live Server ports.
# For production, list your exact viewer and admin URLs.
ALLOWED_ORIGINS=*
# Example: ALLOWED_ORIGINS=https://viewer.yourdomain.com,https://admin.yourdomain.com
