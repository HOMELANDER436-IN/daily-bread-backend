# Daily Bread — Backend Environment Variables
# Copy this file to .env and fill in your Firebase service account values

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── Firebase (Service Account) ───────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate new private key → Download JSON
FIREBASE_PROJECT_ID=manual-4b66a
FIREBASE_CLIENT_EMAIL=your-service-account-email@manual-4b66a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g., your Netlify URLs)
# For development, you can use * or http://localhost:3000
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://dailybread-viewer.netlify.app,https://dailybread-admin.netlify.app

# ─── Timezone ─────────────────────────────────────────────────
PRAYER_TIMEZONE=Asia/Kolkata
